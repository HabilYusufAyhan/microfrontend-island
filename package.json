{
  "name": "microfrontend-island",
  "version": "1.0.0",
  "description": "Microfrontend monorepo using Module Federation with Turborepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.0.0",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:shell": "turbo run dev --filter=shell",
    "dev:vue": "turbo run dev --filter=vue-todo",
    "dev:react": "turbo run dev --filter=react-profile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "preview": "turbo run preview"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "turbo": "^2.7.3"
  },
  "workspaces": [
    "shell",
    "react-profile",
    "vue-todo"
  ]
}
